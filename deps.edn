{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
         org.clojure/data.json {:mvn/version "2.5.2"}}
 :aliases
 {:run {:main-opts ["-m" "harness-clj.core"]}
  :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.8.0"}
                       cider/cider-nrepl {:mvn/version "0.64.1"}}
          :main-opts ["-m" "nrepl.cmdline"
                      "--middleware" "[cider.nrepl/cider-middleware]"]}
  :test {:extra-paths ["test"]
         :main-opts ["-m" "harness-clj.test-runner"]}
  :build {:extra-paths ["dev"]
          :main-opts ["-m" "build"]}
  :outdated {:replace-deps {
    com.github.liquidz/antq {:mvn/version "2.11.1276"}
    org.slf4j/slf4j-simple {:mvn/version "RELEASE"}}
  :jvm-opts ["-Dorg.slf4j.simpleLogger.defaultLogLevel=debug"
             "-Dorg.slf4j.simpleLogger.showDateTime=true"]
  :main-opts ["-m" "antq.core"]}}}
